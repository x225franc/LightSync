<ui:FluentWindow
    x:Class="Ambilight.GUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Ambilight.GUI"
    Title="LightSync"
    Height="680"
    Width="920"
    MinHeight="480"
    MinWidth="760"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LightSync" ShowMaximize="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu -->
            <ListBox x:Name="NavList" Grid.Column="0" Margin="10,8,6,10" SelectedIndex="0"
                     BorderThickness="0" Background="Transparent"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBoxItem AutomationProperties.AutomationId="NavRazer">
                    <StackPanel Orientation="Horizontal" Margin="4,7">
                        <ui:SymbolIcon Symbol="Keyboard24" Margin="0,0,12,0" />
                        <TextBlock Text="Razer devices" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.AutomationId="NavLights">
                    <StackPanel Orientation="Horizontal" Margin="4,7">
                        <ui:SymbolIcon Symbol="Lightbulb24" Margin="0,0,12,0" />
                        <TextBlock Text="Lights" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.AutomationId="NavCanvas">
                    <StackPanel Orientation="Horizontal" Margin="4,7">
                        <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,12,0" />
                        <TextBlock Text="Canvas" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.AutomationId="NavLaptop">
                    <StackPanel Orientation="Horizontal" Margin="4,7">
                        <ui:SymbolIcon Symbol="DesktopKeyboard24" Margin="0,0,12,0" />
                        <TextBlock Text="Laptop keyboard" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.AutomationId="NavCapture">
                    <StackPanel Orientation="Horizontal" Margin="4,7">
                        <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,12,0" />
                        <TextBlock Text="Screen capture" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.AutomationId="NavSettings">
                    <StackPanel Orientation="Horizontal" Margin="4,7">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,12,0" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- Pages -->
            <Grid Grid.Column="1">
                <ScrollViewer x:Name="RazerPage" Margin="6,0,4,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,18,0">

                <TextBlock Text="Razer devices" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8" />

                <ui:CardControl Margin="0,0,0,4" Header="Keyboard">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="KeyboardToggle" Click="KeyboardToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Mouse">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Cursor24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="MouseToggle" Click="MouseToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Mousepad">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Grid24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="PadToggle" Click="PadToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Headset">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Headset24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="HeadsetToggle" Click="HeadsetToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Keypad">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="NumberSymbolSquare24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="KeypadToggle" Click="KeypadToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Chroma Link (Chroma Connect devices)">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Link24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="LinkToggle" Click="LinkToggle_Click" />
                </ui:CardControl>

                <TextBlock Text="Keyboard grid size" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" />
                <ui:CardControl Header="Manual size, width (0-22) x height (0-6)">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="KeyboardWidthBox" Width="70" />
                        <TextBlock Text="x" Margin="8,0,8,0" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="KeyboardHeightBox" Width="70" />
                        <ui:Button
                            Content="Apply"
                            Margin="8,0,0,0"
                            Click="ApplyKeyboardSize_Click" />
                    </StackPanel>
                </ui:CardControl>


                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="LightsPage" Visibility="Collapsed" Margin="6,0,4,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,18,0">

                <TextBlock x:Name="LightsUnavailableText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.8"
                           Text="The lights engine did not start. See the log file for the reason." />
                <StackPanel x:Name="LightsContent">
                <!-- Master switch -->
                <TextBlock Text="Light control" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8" />
                <ui:CardControl Margin="0,0,0,4" Header="Control the lights with Razer Chroma">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Lightbulb24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="ControlToggle" AutomationProperties.AutomationId="ControlToggle"
                                     Checked="ControlToggle_Changed" Unchecked="ControlToggle_Changed" />
                </ui:CardControl>

                <!-- Chroma status -->
                <TextBlock Text="Razer Chroma Connect" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8" />
                <ui:CardControl Margin="0,0,0,4">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock x:Name="ChromaStatusText" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock x:Name="ScanStatusText" TextWrapping="Wrap" Margin="0,2,0,0" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:CardControl.Icon>
                    <ui:Button x:Name="RescanButton" Content="Search again" Click="RescanButton_Click" />
                </ui:CardControl>

                <!-- Shown when Windows Firewall has no rule for this app (Yeelight bulbs connect back to the PC) -->
                <Border x:Name="FirewallBanner" Visibility="Collapsed" Margin="0,4,0,4" Padding="14" CornerRadius="8"
                        Background="#33E5484D" BorderBrush="#88E5484D" BorderThickness="1">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                   Text="Windows Firewall may be blocking the Yeelight bulbs." />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Opacity="0.85"
                                   Text="Yeelight bulbs connect back to this PC to receive colors, and there is no firewall rule for Light Connect yet. Allow it once (Windows will ask for administrator permission)." />
                        <ui:Button Content="Allow Light Connect in the firewall" Click="AllowFirewallButton_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="LightConnectBanner" Visibility="Collapsed" Margin="0,4,0,4" Padding="14" CornerRadius="8"
                        Background="#33E3A008" BorderBrush="#88E3A008" BorderThickness="1">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                   Text="The standalone Light Connect app is running." />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Opacity="0.85"
                                   Text="These lights are now handled here, and the two apps would fight over them. Close it and turn off its autostart." />
                        <ui:Button Content="Close it and disable its autostart" Click="DisableLightConnectButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Shown only while an original app that drives the same lights is running -->
                <Border x:Name="YeelightBanner" Visibility="Collapsed" Margin="0,4,0,4" Padding="14" CornerRadius="8"
                        Background="#33E3A008" BorderBrush="#88E3A008" BorderThickness="1">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                   Text="The official Yeelight Chroma Connector is running." />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Opacity="0.85"
                                   Text="It drives the same bulbs, so the two would fight over them. Close it and turn off its autostart to let this app take over." />
                        <ui:Button Content="Close it and disable its autostart" Click="DisableYeelightButton_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="GoveeBanner" Visibility="Collapsed" Margin="0,4,0,4" Padding="14" CornerRadius="8"
                        Background="#33E3A008" BorderBrush="#88E3A008" BorderThickness="1">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                   Text="Govee Desktop is running." />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Opacity="0.85"
                                   Text="It drives the same devices and also uses the network port this app needs. Close it and turn off its autostart to let this app take over (you can still open it by hand whenever you want)." />
                        <ui:Button Content="Close it and disable its autostart" Click="DisableGoveeButton_Click" />
                    </StackPanel>
                </Border>

                <ui:CardExpander Margin="0,4,0,4" Header="Test which physical light is which group" IsExpanded="False" ContentPadding="16">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Lightbulb24" />
                    </ui:CardExpander.Icon>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Lights up Group 1, then Group 2 to Group 4, one at a time - everything else goes dark while a group is shown, so it is unambiguous which bulb belongs to which group. Needs Razer Chroma Connect to be receiving colors." />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="ColorTestButton" Content="Start the test" Click="ColorTestButton_Click" />
                            <TextBlock x:Name="ColorTestStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Bulbs -->
                <TextBlock Text="Devices" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8" />
                <TextBlock x:Name="NoBulbsText" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                           Text="No device found yet. Make sure LAN Control is on for each device (in the Yeelight app, and in Govee Home) and that this PC is on the same Wi-Fi." />

                <ItemsControl x:Name="BulbList">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,10,0,6">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Opacity="0.9" />
                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" FontSize="13" Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="14" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="34" Height="34" Margin="0,2,14,0" VerticalAlignment="Top"
                                             Fill="{Binding Swatch}" Stroke="#66808080" StrokeThickness="1" />

                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,8,0"
                                                                 ToolTip="Turns this light on or off (its Chroma group is kept while off)" />
                                                <ui:Button Content="Preview"
                                                           Command="{Binding PreviewCommand}"
                                                           ToolTip="Blinks this bulb white so you can see which one it is" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Name" VerticalAlignment="Center" />
                                            <ui:TextBox Grid.Column="1" PlaceholderText="Give this bulb a name"
                                                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Chroma group" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="190"
                                                      Visibility="{Binding YeelightChoices}" IsEnabled="{Binding GroupEnabled}"
                                                      SelectedIndex="{Binding GroupIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Group 1" />
                                                <ComboBoxItem Content="Group 2" />
                                                <ComboBoxItem Content="Group 3" />
                                                <ComboBoxItem Content="Group 4" />
                                            </ComboBox>
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="230"
                                                      Visibility="{Binding GoveeChoices}" IsEnabled="{Binding GroupEnabled}"
                                                      SelectedIndex="{Binding GroupIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="Group 1" />
                                                <ComboBoxItem Content="Group 2" />
                                                <ComboBoxItem Content="Group 3" />
                                                <ComboBoxItem Content="Group 4" />
                                                <ComboBoxItem Content="Groups 1-4 (gradient)" />
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,0,0,8" IsEnabled="{Binding Enabled}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Screen canvas" VerticalAlignment="Center" />
                                            <ui:ToggleSwitch Grid.Column="1" HorizontalAlignment="Left"
                                                              IsChecked="{Binding UseScreenPosition, Mode=TwoWay}"
                                                              ToolTip="Instead of a Chroma group, follow a rectangle placed on the canvas below - no 4-zone limit, any position." />
                                        </Grid>

                                        <Grid IsEnabled="{Binding Enabled}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Brightness" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <ui:CardExpander Margin="0,0,0,4" Header="Govee fix (LAN control / Razer Chroma Connect)" IsExpanded="False" ContentPadding="16">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Lightbulb24" />
                    </ui:CardExpander.Icon>
                    <StackPanel>
                        <TextBlock Text="When to use it" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="A Govee device shows LAN control as unavailable in Govee Desktop (red network icon), or Razer Chroma Connect lists 0 devices, even though the device works in the Govee app." />

                        <TextBlock Text="Why it happens" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Govee finds its devices with a multicast message that Windows sends through the network adapter it prefers, the one with the lowest 'metric'. On a PC with several adapters (VPN, Tailscale, Hyper-V, VirtualBox...) that can be a virtual adapter where no Govee device can answer. Giving the Wi-Fi adapter the lowest metric makes Windows use it." />

                        <TextBlock Text="1.  Apply, in a PowerShell opened as administrator" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="GoveeFixCommandBox" Grid.Column="0" IsReadOnly="True"
                                        FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" TextAlignment="Left" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                       Content="Copy" Click="CopyGoveeFixCommand_Click" />
                        </Grid>

                        <TextBlock Text="2.  Fully quit Govee Desktop (also in the tray) and start it again" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock Text="To undo it" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="GoveeRevertCommandBox" Grid.Column="0" IsReadOnly="True"
                                        FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" TextAlignment="Left" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                       Content="Copy" Click="CopyGoveeRevertCommand_Click" />
                        </Grid>

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="It only changes which adapter Windows prefers; your internet connection and routes are unchanged. If you use a wired connection, replace &quot;Wi-Fi&quot; with the name of that adapter (list them with Get-NetIPInterface)." />
                    </StackPanel>
                </ui:CardExpander>

                </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="CanvasPage" Visibility="Collapsed" Margin="6,0,4,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,18,0">

                <TextBlock Text="Screen canvas" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Drag a device to where it really sits around your screen, and drag its bottom-right corner to resize the area it should reflect. Each box is shown as a grid of small cells matching how many LEDs that device really has. Lights are turned on here with their own 'Screen canvas' switch on the Lights page; Razer devices are turned on below. This bypasses Razer Chroma Connect entirely for lights, so it keeps working even without Synapse running." />

                <Grid x:Name="CanvasScaleHost" HorizontalAlignment="Stretch" SizeChanged="CanvasScaleHost_SizeChanged">
                    <Border x:Name="CanvasBorder" Background="#FF101010" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                            Width="480" Height="270" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Canvas x:Name="PositionCanvas" ClipToBounds="True" />
                    </Border>
                </Grid>
                <TextBlock x:Name="CanvasHintText" Margin="0,8,0,16" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                           Text="Nothing is on the canvas yet." />

                <TextBlock Text="Razer devices on the canvas" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,8" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Each device can either follow its canvas position above, or a Chroma group instead - the same 4 zones a Yeelight/Govee light can be assigned to on the Lights page. Picking a group here turns the canvas box off for that device and paints it that zone's color instead, so it can be mapped to wherever that zone really sits in your setup." />
                <ui:CardControl Margin="0,0,0,4" Header="Keyboard">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CanvasKeyboardGroup" Width="130" Margin="0,0,12,0" SelectionChanged="CanvasDeviceGroup_SelectionChanged">
                            <ComboBoxItem Content="Default" />
                            <ComboBoxItem Content="Group 1" />
                            <ComboBoxItem Content="Group 2" />
                            <ComboBoxItem Content="Group 3" />
                            <ComboBoxItem Content="Group 4" />
                        </ComboBox>
                        <ui:ToggleSwitch x:Name="CanvasKeyboardToggle" Click="CanvasDeviceToggle_Click" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Mouse">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Cursor24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CanvasMouseGroup" Width="130" Margin="0,0,12,0" SelectionChanged="CanvasDeviceGroup_SelectionChanged">
                            <ComboBoxItem Content="Default" />
                            <ComboBoxItem Content="Group 1" />
                            <ComboBoxItem Content="Group 2" />
                            <ComboBoxItem Content="Group 3" />
                            <ComboBoxItem Content="Group 4" />
                        </ComboBox>
                        <ui:ToggleSwitch x:Name="CanvasMouseToggle" Click="CanvasDeviceToggle_Click" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Mousepad">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Grid24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CanvasMousepadGroup" Width="130" Margin="0,0,12,0" SelectionChanged="CanvasDeviceGroup_SelectionChanged">
                            <ComboBoxItem Content="Default" />
                            <ComboBoxItem Content="Group 1" />
                            <ComboBoxItem Content="Group 2" />
                            <ComboBoxItem Content="Group 3" />
                            <ComboBoxItem Content="Group 4" />
                        </ComboBox>
                        <ui:ToggleSwitch x:Name="CanvasMousepadToggle" Click="CanvasDeviceToggle_Click" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Headset">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Headset24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CanvasHeadsetGroup" Width="130" Margin="0,0,12,0" SelectionChanged="CanvasDeviceGroup_SelectionChanged">
                            <ComboBoxItem Content="Default" />
                            <ComboBoxItem Content="Group 1" />
                            <ComboBoxItem Content="Group 2" />
                            <ComboBoxItem Content="Group 3" />
                            <ComboBoxItem Content="Group 4" />
                        </ComboBox>
                        <ui:ToggleSwitch x:Name="CanvasHeadsetToggle" Click="CanvasDeviceToggle_Click" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Keypad">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="NumberSymbolSquare24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CanvasKeypadGroup" Width="130" Margin="0,0,12,0" SelectionChanged="CanvasDeviceGroup_SelectionChanged">
                            <ComboBoxItem Content="Default" />
                            <ComboBoxItem Content="Group 1" />
                            <ComboBoxItem Content="Group 2" />
                            <ComboBoxItem Content="Group 3" />
                            <ComboBoxItem Content="Group 4" />
                        </ComboBox>
                        <ui:ToggleSwitch x:Name="CanvasKeypadToggle" Click="CanvasDeviceToggle_Click" />
                    </StackPanel>
                </ui:CardControl>

                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="LaptopPage" Visibility="Collapsed" Margin="6,0,4,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,18,0">

                <TextBlock Text="Laptop keyboard (Windows Dynamic Lighting)" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8" />

                <ui:CardControl Margin="0,0,0,4" Header="Enabled">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="DesktopKeyboard24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="LaptopKeyboardToggle" Click="LaptopKeyboardToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Effect">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:CardControl.Icon>
                    <ComboBox x:Name="LaptopEffectCombo" Width="170" SelectionChanged="LaptopEffectCombo_SelectionChanged" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Brightness">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Lightbulb24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="LaptopBrightnessSlider" Width="150" Minimum="0" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="LaptopBrightnessSlider_ValueChanged" />
                        <TextBlock x:Name="LaptopBrightnessText" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl x:Name="LaptopSpeedCard" Margin="0,0,0,4" Header="Effect speed">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Gauge24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="LaptopSpeedSlider" Width="150" Minimum="1" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="LaptopSpeedSlider_ValueChanged" />
                        <TextBlock x:Name="LaptopSpeedText" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl x:Name="LaptopColorCard" Margin="0,0,0,4" Header="Color">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Color24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <local:ColorWheel x:Name="LaptopColorWheel" Width="140" Height="140" Margin="0,8,0,8" />
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Width="112">
                            <Border x:Name="LaptopColorSwatch" Height="26" CornerRadius="4" Margin="0,0,0,8"
                                    BorderThickness="1" BorderBrush="#55FFFFFF" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="R" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="LaptopRedBox" Grid.Column="1" MaxLength="3" TextChanged="LaptopRgbBox_TextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="G" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="LaptopGreenBox" Grid.Column="1" MaxLength="3" TextChanged="LaptopRgbBox_TextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="LaptopBlueBox" Grid.Column="1" MaxLength="3" TextChanged="LaptopRgbBox_TextChanged" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="LaptopHexBox" Grid.Column="1" MaxLength="7" FontFamily="Consolas" TextChanged="LaptopHexBox_TextChanged" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl x:Name="LaptopReverseCard" Margin="0,0,0,4" Header="Reverse direction">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="LaptopReverseToggle" Click="LaptopReverseToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Status">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="SlideSettings24" />
                    </ui:CardControl.Icon>
                    <TextBlock x:Name="LaptopStatusText" MaxWidth="230" TextWrapping="Wrap" TextAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:CardControl>
                <ui:CardExpander Margin="0,0,0,4" Header="One-time setup on a new PC" IsExpanded="False" ContentPadding="16">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:CardExpander.Icon>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Lets LightSync control this keyboard while another app is in the foreground. Needed once per PC." />

                        <TextBlock Text="1.  Run in a PowerShell opened as administrator" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="SetupCommandBox" Grid.Column="0" IsReadOnly="True"
                                        FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                        HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Center" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                       Content="Copy" Click="CopySetupCommand_Click" />
                        </Grid>

                        <TextBlock Text="2.  Restart LightSync" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <TextBlock Text="3.  Give it priority in Windows" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Settings > Personalization > Dynamic Lighting > Background light control: drag LightSync to the top." />

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Windows can take about 30 seconds after each start to hand the keyboard over." />
                    </StackPanel>
                </ui:CardExpander>


                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="CapturePage" Visibility="Collapsed" Margin="6,0,4,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,18,0">

                <TextBlock Text="Screen capture" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8" />

                <ui:CardControl Margin="0,0,0,4" Header="Max FPS">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Gauge24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="TickrateSlider" Width="190" Minimum="1" Maximum="60" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="TickrateSlider_ValueChanged" />
                        <TextBlock x:Name="TickrateText" Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Saturation">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Color24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="SaturationSlider" Width="190" Minimum="-100" Maximum="300" TickFrequency="5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="SaturationSlider_ValueChanged" />
                        <TextBlock x:Name="SaturationText" Width="64" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Brightness of the devices and lights">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Lightbulb24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="DeviceBrightnessSlider" Width="150" Minimum="10" Maximum="300"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="DeviceBrightnessSlider_ValueChanged" />
                        <TextBlock x:Name="DeviceBrightnessText" Width="52" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Monitor to capture">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Desktop24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="MonitorCombo" Width="160" SelectionChanged="MonitorCombo_SelectionChanged" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="'Real' Ambilight mode">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="AmbiToggle" Click="AmbiToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Keep the effect during the screensaver">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Desktop24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="KeepScreensaverToggle" Click="KeepScreensaverToggle_Click"
                                     ToolTip="Windows normally hides the screensaver from screen capture. When on, Ambilight follows it and keeps lighting your devices with what it shows. The lock screen still cannot be captured." />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Ultrawide monitor mode">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="DualScreenDesktop24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="UltrawideToggle" Click="UltrawideToggle_Click" />
                </ui:CardControl>


                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Margin="6,0,4,8" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,18,0">

                <TextBlock Text="General" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" />
                <ui:CardControl Margin="0,0,0,4" Header="Start with Windows">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Power24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="AutostartToggle" Click="AutostartToggle_Click" />
                </ui:CardControl>


                                <TextBlock Text="Lights" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" />
                <ui:CardControl Margin="0,0,0,4" Header="Smooth transitions (interpolation)">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="InterpolateToggle" AutomationProperties.AutomationId="InterpolateToggle"
                                     Checked="InterpolateToggle_Changed" Unchecked="InterpolateToggle_Changed"
                                     ToolTip="Razer sends about 20 colors per second. This blends between them so lights glide at the update rate below instead of stepping." />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Yeelight: turn off in the dark">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Lightbulb24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="YeelightOffSlider" Width="150" Minimum="0" Maximum="25" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="YeelightOffSlider_ValueChanged" />
                        <TextBlock x:Name="YeelightOffText" Width="96" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Yeelight: fade out before turning off">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Lightbulb24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="YeelightFadeSlider" Width="150" Minimum="0" Maximum="1500" TickFrequency="50"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="YeelightFadeSlider_ValueChanged" />
                        <TextBlock x:Name="YeelightFadeText" Width="96" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Govee update rate (frames per second)">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Gauge24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="GoveeFpsSlider" Width="150" Minimum="5" Maximum="30" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="GoveeFpsSlider_ValueChanged" />
                        <TextBlock x:Name="GoveeFpsText" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Yeelight update rate (frames per second)">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Gauge24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="YeelightFpsSlider" Width="150" Minimum="5" Maximum="30" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="YeelightFpsSlider_ValueChanged" />
                        <TextBlock x:Name="YeelightFpsText" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <TextBlock Text="Maintenance" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8" />
                <ui:CardControl Margin="0,0,0,4" Header="Log files">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Document24" />
                    </ui:CardControl.Icon>
                    <ui:Button Content="Open folder" Click="OpenLogs_Click" />
                </ui:CardControl>
                <ui:CardControl x:Name="RestoreCard" Visibility="Collapsed" Margin="0,0,0,4"
                                Header="Autostart of the original apps was turned off">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ArrowUndo24" />
                    </ui:CardControl.Icon>
                    <ui:Button Content="Restore them" Click="RestoreOriginals_Click" />
                </ui:CardControl>



                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="200,0,16,10"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </Grid>
</ui:FluentWindow>
