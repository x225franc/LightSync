<ui:FluentWindow
    x:Class="Ambilight.GUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Ambilight.GUI"
    Title="Razer Ambilight"
    Height="620"
    Width="460"
    MinHeight="480"
    MinWidth="400"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Razer Ambilight"
            ShowMaximize="False" />

        <ScrollViewer
            Grid.Row="1"
            Margin="16,0,4,16"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,18,0">

                <TextBlock Text="Devices" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8" />

                <ui:CardControl Margin="0,0,0,4" Header="Keyboard">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="KeyboardToggle" Click="KeyboardToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Mouse">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Cursor24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="MouseToggle" Click="MouseToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Mousepad">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Grid24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="PadToggle" Click="PadToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Headset">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Headset24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="HeadsetToggle" Click="HeadsetToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Keypad">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="NumberSymbolSquare24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="KeypadToggle" Click="KeypadToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Chroma Link (Chroma Connect devices)">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Link24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="LinkToggle" Click="LinkToggle_Click" />
                </ui:CardControl>

                <TextBlock Text="Laptop keyboard (Windows Dynamic Lighting)" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" />

                <ui:CardControl Margin="0,0,0,4" Header="Enabled">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="DesktopKeyboard24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="LaptopKeyboardToggle" Click="LaptopKeyboardToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Effect">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:CardControl.Icon>
                    <ComboBox x:Name="LaptopEffectCombo" Width="170" SelectionChanged="LaptopEffectCombo_SelectionChanged" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Brightness">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Lightbulb24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="LaptopBrightnessSlider" Width="150" Minimum="0" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="LaptopBrightnessSlider_ValueChanged" />
                        <TextBlock x:Name="LaptopBrightnessText" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl x:Name="LaptopSpeedCard" Margin="0,0,0,4" Header="Effect speed">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Gauge24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="LaptopSpeedSlider" Width="150" Minimum="1" Maximum="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                ValueChanged="LaptopSpeedSlider_ValueChanged" />
                        <TextBlock x:Name="LaptopSpeedText" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl x:Name="LaptopColorCard" Margin="0,0,0,4" Header="Color">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Color24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <local:ColorWheel x:Name="LaptopColorWheel" Width="140" Height="140" Margin="0,8,0,8" />
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Width="112">
                            <Border x:Name="LaptopColorSwatch" Height="26" CornerRadius="4" Margin="0,0,0,8"
                                    BorderThickness="1" BorderBrush="#55FFFFFF" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="R" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="LaptopRedBox" Grid.Column="1" MaxLength="3" TextChanged="LaptopRgbBox_TextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="G" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="LaptopGreenBox" Grid.Column="1" MaxLength="3" TextChanged="LaptopRgbBox_TextChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="LaptopBlueBox" Grid.Column="1" MaxLength="3" TextChanged="LaptopRgbBox_TextChanged" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="LaptopHexBox" Grid.Column="1" MaxLength="7" FontFamily="Consolas" TextChanged="LaptopHexBox_TextChanged" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl x:Name="LaptopReverseCard" Margin="0,0,0,4" Header="Reverse direction">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="LaptopReverseToggle" Click="LaptopReverseToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Status">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="SlideSettings24" />
                    </ui:CardControl.Icon>
                    <TextBlock x:Name="LaptopStatusText" MaxWidth="230" TextWrapping="Wrap" TextAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ui:CardControl>
                <ui:CardExpander Margin="0,0,0,4" Header="One-time setup on a new PC" IsExpanded="False" ContentPadding="16">
                    <ui:CardExpander.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:CardExpander.Icon>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Lets Razer Ambilight control this keyboard while another app is in the foreground. Needed once per PC." />

                        <TextBlock Text="1.  Run in a PowerShell opened as administrator" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="SetupCommandBox" Grid.Column="0" IsReadOnly="True"
                                        FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                        HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Center" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch"
                                       Content="Copy" Click="CopySetupCommand_Click" />
                        </Grid>

                        <TextBlock Text="2.  Restart Razer Ambilight" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <TextBlock Text="3.  Give it priority in Windows" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock TextWrapping="Wrap" Margin="20,0,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Settings > Personalization > Dynamic Lighting > Background light control: drag Razer Ambilight to the top." />

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Windows can take about 30 seconds after each start to hand the keyboard over." />
                    </StackPanel>
                </ui:CardExpander>

                <TextBlock Text="Capture" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" />

                <ui:CardControl Margin="0,0,0,4" Header="Max FPS (1-60)">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Gauge24" />
                    </ui:CardControl.Icon>
                    <ui:TextBox
                        x:Name="TickrateBox"
                        Width="90"
                        TextChanged="TickrateBox_TextChanged" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Saturation % (-100 to 300)">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Color24" />
                    </ui:CardControl.Icon>
                    <ui:TextBox
                        x:Name="SaturationBox"
                        Width="90"
                        TextChanged="SaturationBox_TextChanged" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Monitor to capture">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Desktop24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="MonitorCombo" Width="160" SelectionChanged="MonitorCombo_SelectionChanged" />
                    </StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="'Real' Ambilight mode">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="AmbiToggle" Click="AmbiToggle_Click" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Ultrawide monitor mode">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="DualScreenDesktop24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="UltrawideToggle" Click="UltrawideToggle_Click" />
                </ui:CardControl>

                <TextBlock Text="Keyboard grid size" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" />
                <ui:CardControl Header="Manual size, width (0-22) x height (0-6)">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox x:Name="KeyboardWidthBox" Width="70" />
                        <TextBlock Text="x" Margin="8,0,8,0" VerticalAlignment="Center" />
                        <ui:TextBox x:Name="KeyboardHeightBox" Width="70" />
                        <ui:Button
                            Content="Apply"
                            Margin="8,0,0,0"
                            Click="ApplyKeyboardSize_Click" />
                    </StackPanel>
                </ui:CardControl>

                <TextBlock Text="General" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8" />
                <ui:CardControl Margin="0,0,0,4" Header="Start with Windows">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Power24" />
                    </ui:CardControl.Icon>
                    <ui:ToggleSwitch x:Name="AutostartToggle" Click="AutostartToggle_Click" />
                </ui:CardControl>

                <TextBlock
                    x:Name="StatusText"
                    Margin="0,16,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
